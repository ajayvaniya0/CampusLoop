# ==============================================
# CampusLoop Environment Configuration Example
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/campusloop

# Frontend Client URL (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Authentication (JWT)
JWT_SECRET=campusloop_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Frontend API Base URL (if configured in client)
VITE_API_BASE_URL=http://localhost:5000/api
